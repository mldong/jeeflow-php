# jeeflow-php demo Docker 镜像
FROM php:8.1-cli

# 安装 Composer + PHP 扩展（zip 为 composer download 所需）
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN apt-get update -qq && apt-get install -y -qq libzip-dev unzip > /dev/null 2>&1 \
    && docker-php-ext-install zip > /dev/null 2>&1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制引擎源码（构建上下文 = 包含 jeeflow-php/ 和 jeeflow-java/ 的父目录）
COPY jeeflow-php/packages/ /app/packages/
COPY jeeflow-php/composer.json /app/

# 复制 demo
COPY jeeflow-php/demo-slim/ /app/demo-slim/

# 复制共享流程 JSON（demo-init.php 期望 dirname(__DIR__,3)/jeeflow-java/...）
COPY jeeflow-java/jeeflow-core/src/test/resources/flows /jeeflow-java/jeeflow-core/src/test/resources/flows

# 安装依赖（--no-scripts 避免 init 脚本在 autoload 就绪前执行）
RUN cd /app/demo-slim && composer install --no-dev --no-scripts --no-interaction

# 初始化 SQLite 数据库 + 部署示例流程
RUN cd /app/demo-slim && php bin/demo-init.php

EXPOSE 8090

# php -S 必须绑定 0.0.0.0（容器内 localhost 外部不可达）
CMD ["php", "-S", "0.0.0.0:8090", "-t", "public"]
WORKDIR /app/demo-slim
